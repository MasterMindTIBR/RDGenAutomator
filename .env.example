# Copy to .env and replace every placeholder. Do not commit .env.
DATABASE_URL=postgresql://rdgen:rdgen@localhost:5432/rdgen_automator
REDIS_URL=redis://localhost:6379
APP_STORAGE_PATH=./storage
APP_ENCRYPTION_KEY=PLACEHOLDER_APP_ENCRYPTION_KEY
APP_ENCRYPTION_KEY_ID=PLACEHOLDER_APP_ENCRYPTION_KEY_ID
API_PORT=PLACEHOLDER_API_PORT
WEB_PORT=PLACEHOLDER_WEB_PORT
WORKER_PORT=PLACEHOLDER_WORKER_PORT
# Defaults to 127.0.0.1. Set to 0.0.0.0 only when a container must accept traffic from another container.
APP_BIND_HOST=127.0.0.1
API_BASE_URL=PLACEHOLDER_API_BASE_URL
# Required only by `pnpm db:seed`; an existing administrator is not overwritten.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=PLACEHOLDER_ADMIN_PASSWORD
# Required only by `pnpm encryption:rotate`.
REENCRYPT_NEW_APP_ENCRYPTION_KEY=PLACEHOLDER_REENCRYPT_NEW_APP_ENCRYPTION_KEY
REENCRYPT_NEW_APP_ENCRYPTION_KEY_ID=PLACEHOLDER_REENCRYPT_NEW_APP_ENCRYPTION_KEY_ID
